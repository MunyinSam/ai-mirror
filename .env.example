# Copy to .env (gitignored). Matches docker-compose.yml defaults.
DATABASE_URL=postgres://mirror:mirror@localhost:5433/ai_mirror

# Tier-2 classification (Haiku). Absent = classification is skipped, never fails.
ANTHROPIC_API_KEY=

# Embeddings via a local Ollama running nomic-embed-text (768 dims).
# Absent = concept resolution falls back to exact title match.
OLLAMA_URL=http://localhost:11434
